[Unit]
Description=mediasync media session bridge
Documentation=https://github.com/arkaizn/mediasync
# MPRIS players and the Secret Service live on the user session bus.
After=dbus.socket
Requires=dbus.socket

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=30
ExecStart=@BINDIR@/mediasyncd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

# Hardening that works in user service managers.
UMask=0077
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Resource bounds.
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=default.target
